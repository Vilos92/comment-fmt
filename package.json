    "typescript": "^7.0.2",
    "vite-plus": "^0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
