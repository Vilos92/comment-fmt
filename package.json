{
  "name": "comment-fmt",
  "version": "0.0.0",
  "description": "Reformats comments in JS/TS, CSS/SCSS, and HTML to a fixed width with a consistent block shape.",
  "keywords": [
    "cli",
    "comments",
    "formatter",
    "jsdoc",
    "reflow",
    "wrap"
  ],
  "homepage": "https://github.com/Vilos92/comment-fmt#readme",
  "bugs": {
    "url": "https://github.com/Vilos92/comment-fmt/issues"
  },
  "license": "MIT",
  "author": "Gregory Linscheid <linscheid.greg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vilos92/comment-fmt.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.14"
}
