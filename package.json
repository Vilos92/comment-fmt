{
  "name": "comment-fmt",
  "version": "0.1.2",
  "description": "Reformats comments in JS/TS, CSS/SCSS, HTML, and Astro to a fixed width with a consistent block shape.",
  "keywords": [
    "cli",
    "comments",
    "formatter",
    "jsdoc",
    "reflow",
    "wrap"
  ],
  "homepage": "https://github.com/Vilos92/comment-fmt#readme",
  "bugs": {
    "url": "https://github.com/Vilos92/comment-fmt/issues"
  },
  "license": "MIT",
  "author": "Gregory Linscheid <linscheid.greg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vilos92/comment-fmt.git"
  },
  "bin": {
    "comment-fmt": "dist/cli/index.mjs"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "comment-fmt:check": "bun src/cli/index.ts --check",
    "dev": "vp pack --watch",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "prepare": "vp config",
    "prepublishOnly": "vp run build",
    "test": "vp test",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "dependencies": {
    "ansi-regex": "^5.0.1",
    "ansi-styles": "^5.2.0",
    "args-tokenizer": "^0.3.0",
    "aria-query": "^5.3.0",
    "assertion-error": "^2.0.1",
    "cac": "^7.0.0",
    "chai": "^6.2.2",
    "convert-source-map": "^2.0.0",
    "defu": "^6.1.7",
    "dequal": "^2.0.3",
    "detect-libc": "^2.1.2",
    "dom-accessibility-api": "^0.5.16",
    "es-module-lexer": "^2.3.1",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "fdir": "^6.5.0",
    "fsevents": "^2.3.3",
    "jiti": "^2.7.0",
    "js-tokens": "^4.0.0",
    "jsonc-parser": "^3.3.1",
    "lightningcss": "^1.33.0",
    "lightningcss-darwin-arm64": "^1.33.0",
    "lz-string": "^1.5.0",
    "magic-string": "^0.30.21",
    "mrmime": "^2.0.1",
    "nanoid": "^3.3.16",
    "obug": "^2.1.4",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "package-manager-detector": "^1.8.0",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.23",
    "pretty-format": "^27.5.1",
    "pure-rand": "^8.4.2",
    "quansync": "^1.0.0",
    "react-is": "^17.0.2",
    "semver": "^7.8.5",
    "siginfo": "^2.0.0",
    "sirv": "^3.0.2",
    "source-map-js": "^1.2.1",
    "stackback": "^0.0.2",
    "std-env": "^4.2.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^1.2.4",
    "tinyglobby": "^0.2.17",
    "tinypool": "^2.1.0",
    "tinyrainbow": "^3.1.0",
    "totalist": "^3.0.1",
    "unconfig": "^7.5.0",
    "unconfig-core": "^7.5.0",
    "undici-types": "^8.3.0",
    "vite": "^0.2.7",
    "vitest": "^4.1.10",
    "why-is-node-running": "^2.3.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "yuku-codegen": "^0.5.48",
    "yuku-parser": "^0.5.48"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
